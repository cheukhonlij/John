# Firebase web app config (Firebase console → Project settings → Your apps → SDK setup).
# These values are not secret: access is enforced by firestore.rules.
# Copy this file to .env.local and fill it in. Leave empty to keep the
# browser-only (localStorage) mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to true to use the local Firebase emulators instead of the real project.
VITE_FIREBASE_EMULATOR=false
