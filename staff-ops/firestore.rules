rules_version = '2';

// Access for the staff operations app.
//   staff   – read everything; tick workflow items, record stock movements,
//             submit (and cancel their own pending) leave requests
//   manager – everything, including roster, approvals, SOPs and accounts
//   owner   – the account that did first-time setup (config/bootstrap.by),
//             while it is still a manager. Only the owner can read or write the
//             invoice system (inv* collections): customers, prices, invoices.
//             Other managers and staff never see it.
// Signing up alone grants nothing: a users/{uid} profile, written by a
// manager, is what gives an account access.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function role() {
      return get(profilePath()).data.role;
    }
    function isStaff() {
      return signedIn() && exists(profilePath()) && role() in ['staff', 'manager'];
    }
    function isManager() {
      return signedIn() && exists(profilePath()) && role() == 'manager';
    }
    function bootstrapPath() {
      return /databases/$(database)/documents/config/bootstrap;
    }
    function isOwner() {
      return isManager()
        && exists(bootstrapPath())
        && get(bootstrapPath()).data.by == request.auth.uid;
    }

    // One-time setup: the very first account may make itself manager, in the
    // same batch that creates config/bootstrap. After that only managers add users.
    match /config/bootstrap {
      allow read: if true;
      allow create: if signedIn()
        && getAfter(profilePath()).data.role == 'manager';
    }

    match /config/settings {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /users/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow create: if isManager()
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.role == 'manager'
            && !exists(bootstrapPath())
            && existsAfter(bootstrapPath()));
      allow update, delete: if isManager();
    }

    // Planning data: everyone reads, managers change.
    match /employees/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }
    match /shiftTemplates/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }
    match /shifts/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }
    match /holidays/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }
    match /workflowTasks/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }
    match /sops/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }
    match /stockItems/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    // Day-to-day records staff create themselves.
    match /workflowChecks/{id} {
      allow read, write: if isStaff();
    }
    match /movements/{id} {
      allow read, create: if isStaff();
      allow update, delete: if isManager();
    }
    // Stock totals move with every movement staff record, so staff update them too.
    match /stockLevels/{id} {
      allow read, write: if isStaff();
    }
    match /leaves/{id} {
      allow read: if isStaff();
      allow create: if isManager()
        || (isStaff() && request.resource.data.status == 'pending');
      allow update: if isManager();
      allow delete: if isManager()
        || (isStaff() && resource.data.status == 'pending');
    }

    // Delivery notes: managers write them; whoever delivers records the
    // customer's signature once, without touching what was sent. Customer
    // names and addresses only — prices stay in the inv* collections below.
    match /deliveryCustomers/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }
    match /deliveryNotes/{id} {
      allow read: if isStaff();
      allow create, delete: if isManager();
      allow update: if isManager()
        || (isStaff()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'signed'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'signedAt', 'signedBy', 'receiverName', 'signature', 'receivedQty', 'receivedNotes']));
    }

    // Invoice system (開單台): owner only. Customer details, selling prices,
    // invoices, prepaid meal tickets, invoice-number counters and invoice settings.
    match /invCustomers/{id} {
      allow read, write: if isOwner();
    }
    match /invItems/{id} {
      allow read, write: if isOwner();
    }
    match /invInvoices/{id} {
      allow read, write: if isOwner();
    }
    match /invTickets/{id} {
      allow read, write: if isOwner();
    }
    match /invCounters/{id} {
      allow read, write: if isOwner();
    }
    match /invConfig/{id} {
      allow read, write: if isOwner();
    }
  }
}
